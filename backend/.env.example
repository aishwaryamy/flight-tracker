# Amadeus API (get free keys at developers.amadeus.com)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/flighttracker
DATABASE_URL_SYNC=postgresql://postgres:password@db:5432/flighttracker

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SendGrid (get free key at sendgrid.com)
SENDGRID_API_KEY=your_sendgrid_api_key
ALERT_FROM_EMAIL=alerts@yourapp.com

# App
APP_ENV=development
FRONTEND_URL=http://localhost:5173
